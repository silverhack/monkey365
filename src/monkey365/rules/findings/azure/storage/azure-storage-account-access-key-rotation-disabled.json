    "rule": {
        "path": "az_storage_accounts",
        "subPath": null,
        "selectCondition": {
            
        },
        "query": [
            {
                "filter": [
                    {
                        "conditions": [
                            [
                                "keys.keyRotation.key1.lastRotatedInDays",
                                "eq",
                                "_ARG_0_"
                            ],
                            [
                                "keys.keyRotation.key2.lastRotatedInDays",
                                "eq",
                                "_ARG_0_"
                            ]
                        ],
                        "operator": "or"
                    }
                ]
            }
        ],
        "shouldExist": null,
        "returnObject": null,
        "removeIfNotExists": null
    },
