              ],
              [
                "policy.DeliverMessageAfterScan",
                "eq",
                "True"
              ],
              [
                "policy.DisableUrlRewrite",
                "eq",
                "false"
              ]
            ],
            "operator": "and"
          }
        ]
      }
    ],
    "shouldExist": true,
