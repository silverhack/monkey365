        "data": {
            "properties": {
                "effectiveUsers.*": null,
                "RoleName": "roleName",
                "description": "roleDescription",
                "templateId": "templateId"
            },
            "expandObject": "effectiveUsers"
        },
        "query": [
            {
                "filter": [
                    {
                        "conditions": [
                            [
                                "templateId",
                                "eq",
